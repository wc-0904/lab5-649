# Keep the upstream checkout unchanged. Fail closed if the expected driver changes.
set(lab_driver "${ZEPHYR_BASE}/drivers/can/can_mcp2515.c")
file(READ "${lab_driver}" lab_driver_text)
set(lab_old "K_PRIO_COOP(dev_cfg->int_thread_priority)")
string(FIND "${lab_driver_text}" "${lab_old}" lab_priority_position)
if(lab_priority_position EQUAL -1)
  message(FATAL_ERROR "MCP2515 driver changed: review the preemptive adaptation")
endif()
string(REPLACE "${lab_old}" "K_PRIO_PREEMPT(dev_cfg->int_thread_priority)"
  lab_driver_text "${lab_driver_text}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/can_mcp2515_preempt.c" "${lab_driver_text}")
get_target_property(lab_can_sources drivers__can SOURCES)
set(lab_driver_found FALSE)
foreach(lab_source IN LISTS lab_can_sources)
  if(lab_source MATCHES "(^|/)can_mcp2515\\.c$")
    list(REMOVE_ITEM lab_can_sources "${lab_source}")
    set(lab_driver_found TRUE)
  endif()
endforeach()
if(NOT lab_driver_found)
  message(FATAL_ERROR "Cannot locate MCP2515 source in drivers__can")
endif()
set_property(TARGET drivers__can PROPERTY SOURCES "${lab_can_sources}")
target_sources(drivers__can PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/can_mcp2515_preempt.c")
target_include_directories(drivers__can PRIVATE "${ZEPHYR_BASE}/drivers/can")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lab_driver}")
